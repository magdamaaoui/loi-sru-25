{
  "name": "research-dashboards",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dashboards/loi-sru --",
    "dev:sru": "npm run dev --workspace @dashboards/loi-sru --",
    "dev:heat": "npm run dev --workspace @dashboards/what-heat-costs --",
    "build": "npm run build:sru && node scripts/stage-sru-build.mjs",
    "build:sru": "npm run build --workspace @dashboards/loi-sru",
    "build:heat": "npm run build --workspace @dashboards/what-heat-costs",
    "build:all": "npm run build:sru && npm run build:heat",
    "preview": "npm run preview --workspace @dashboards/loi-sru --",
    "preview:heat": "npm run preview --workspace @dashboards/what-heat-costs --",
    "check": "npm run check --workspaces --if-present",
    "check:sru": "npm run check --workspace @dashboards/loi-sru",
    "check:heat": "npm run check --workspace @dashboards/what-heat-costs",
    "check:watch": "npm run check:watch --workspace @dashboards/loi-sru",
    "prepare": "npm run prepare --workspaces --if-present",
    "test": "npm run test:e2e",
    "test:e2e": "npm run test:e2e --workspace @dashboards/loi-sru --",
    "studio:dev": "npm --prefix studio run dev",
    "studio:build": "npm --prefix studio run build",
    "optimize-images": "npm run optimize-images --workspace @dashboards/loi-sru --",
    "optimize-headlines": "npm run optimize-headlines --workspace @dashboards/loi-sru --",
    "build-map-fallbacks": "npm run build-map-fallbacks --workspace @dashboards/loi-sru --",
    "content:report": "npm run content:report --workspace @dashboards/loi-sru --",
    "content:export": "npm run content:export --workspace @dashboards/loi-sru --",
    "content:extract-bibliography": "npm run content:extract-bibliography --workspace @dashboards/loi-sru --"
  }
}
